<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_Hospital_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:message id="Message_PatientCheckIn" name="PatientCheckInReceived" />
  <bpmn:error id="Error_InsuranceClaimRejected" name="InsuranceClaimRejected" errorCode="ERR_INSURANCE_REJECTED" />
  <bpmn:collaboration id="Collaboration_Process_Hospital_ToBe">
    <bpmn:participant id="Participant_External_Process_Hospital_ToBe" name="Bệnh nhân (Kiosk / App) &amp; Cổng BHYT / HIS-LIS-RIS" />
    <bpmn:participant id="Participant_Process_Hospital_ToBe" name="Hệ thống Điều phối Bệnh viện (To-Be)" processRef="Process_Hospital_ToBe" />
    <bpmn:messageFlow id="MF1_1" name="Check-in QR / Kiosk" sourceRef="Participant_External_Process_Hospital_ToBe" targetRef="Start_P1_Kiosk" />
    <bpmn:messageFlow id="MF1_2" name="Gửi cổng BHYT / Prior Auth" sourceRef="ST_P1_SubmitClaim" targetRef="Participant_External_Process_Hospital_ToBe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Hospital_ToBe" name="Bệnh viện: Tiếp nhận, Phân luồng &amp; Đối soát Bảo hiểm (To-Be)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Process_Hospital_ToBe">
      <bpmn:lane id="Lane_P1_System" name="Hệ thống Điều phối (Camunda + HIS/LIS/RIS)">
        <bpmn:flowNodeRef>Start_P1_Kiosk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P1_SyncHIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_P1_TriageDMN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P1_PrioritySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P1_EmergencyAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P1_QueueAssign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P1_PriorityJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P1_OrderFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P1_CallLIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P1_BookRIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P1_CalcDeposit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P1_OrderJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P1_SubmitClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P1_FinalSettlement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P1_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_P1_ClaimErr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_TriageNurse" name="Điều dưỡng Phân luồng">
        <bpmn:flowNodeRef>UT_P1_VitalSigns</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_ClinicalDoctor" name="Bác sĩ Điều trị">
        <bpmn:flowNodeRef>UT_P1_DoctorOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_P1_DoctorDischarge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P1_Auditor" name="Nhân viên Giám định Bảo hiểm">
        <bpmn:flowNodeRef>UT_P1_HandleClaimEx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P1_RetryOrSelfPay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_P1_Kiosk" name="Nhận đăng ký từ Kiosk / App">
      <bpmn:outgoing>FT1_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Start_P1_Kiosk" messageRef="Message_PatientCheckIn" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST_P1_SyncHIS" name="Xác thực CCCD/BHYT &amp; đồng bộ HIS" camunda:type="external" camunda:topic="his-patient-verify-sync">
      <bpmn:incoming>FT1_1</bpmn:incoming>
      <bpmn:outgoing>FT1_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UT_P1_VitalSigns" name="Đo chỉ số sinh tồn &amp; nhập triệu chứng" camunda:candidateGroups="triage_nurses" camunda:formKey="camunda-forms:app:forms/vital-signs.form">
      <bpmn:incoming>FT1_2</bpmn:incoming>
      <bpmn:outgoing>FT1_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="BRT_P1_TriageDMN" name="DMN Phân luồng ưu tiên &amp; chỉ định phòng" camunda:resultVariable="triageResult" camunda:decisionRef="Decision_TriagePriority" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>FT1_3</bpmn:incoming>
      <bpmn:outgoing>FT1_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GW_P1_PrioritySplit" name="Mức độ ưu tiên?">
      <bpmn:incoming>FT1_4</bpmn:incoming>
      <bpmn:outgoing>FT1_5</bpmn:outgoing>
      <bpmn:outgoing>FT1_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_P1_EmergencyAlert" name="Báo động đỏ &amp; chuyển phòng Cấp cứu" camunda:type="external" camunda:topic="emergency-red-alert">
      <bpmn:incoming>FT1_5</bpmn:incoming>
      <bpmn:outgoing>FT1_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_P1_QueueAssign" name="Cấp số tự động theo mức ưu tiên" camunda:type="external" camunda:topic="queue-auto-assign">
      <bpmn:incoming>FT1_6</bpmn:incoming>
      <bpmn:outgoing>FT1_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_P1_PriorityJoin">
      <bpmn:incoming>FT1_7</bpmn:incoming>
      <bpmn:incoming>FT1_8</bpmn:incoming>
      <bpmn:outgoing>FT1_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_P1_DoctorOrder" name="Bác sĩ khám &amp; ra y lệnh cận lâm sàng" camunda:candidateGroups="doctors" camunda:formKey="camunda-forms:app:forms/clinical-order.form">
      <bpmn:incoming>FT1_9</bpmn:incoming>
      <bpmn:outgoing>FT1_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="GW_P1_OrderFork" name="Tách luồng y lệnh">
      <bpmn:incoming>FT1_10</bpmn:incoming>
      <bpmn:outgoing>FT1_11</bpmn:outgoing>
      <bpmn:outgoing>FT1_12</bpmn:outgoing>
      <bpmn:outgoing>FT1_13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="ST_P1_CallLIS" name="Gọi API Xét nghiệm (LIS)" camunda:type="external" camunda:topic="lis-lab-order">
      <bpmn:incoming>FT1_11</bpmn:incoming>
      <bpmn:outgoing>FT1_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_P1_BookRIS" name="Giữ lịch Chẩn đoán hình ảnh (RIS)" camunda:type="external" camunda:topic="ris-imaging-booking">
      <bpmn:incoming>FT1_12</bpmn:incoming>
      <bpmn:outgoing>FT1_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_P1_CalcDeposit" name="Tính tạm ứng viện phí &amp; gửi QR" camunda:type="external" camunda:topic="billing-deposit-calc">
      <bpmn:incoming>FT1_13</bpmn:incoming>
      <bpmn:outgoing>FT1_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_P1_OrderJoin" name="Hội tụ kết quả">
      <bpmn:incoming>FT1_14</bpmn:incoming>
      <bpmn:incoming>FT1_15</bpmn:incoming>
      <bpmn:incoming>FT1_16</bpmn:incoming>
      <bpmn:outgoing>FT1_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UT_P1_DoctorDischarge" name="Tổng hợp kết quả, mã ICD-10 &amp; xuất viện" camunda:candidateGroups="doctors" camunda:formKey="camunda-forms:app:forms/discharge-summary.form">
      <bpmn:incoming>FT1_17</bpmn:incoming>
      <bpmn:outgoing>FT1_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_P1_SubmitClaim" name="Ánh xạ ICD-10 &amp; gửi cổng giám định BHYT" camunda:type="external" camunda:topic="insurance-claim-submit">
      <bpmn:incoming>FT1_18</bpmn:incoming>
      <bpmn:incoming>FT1_22</bpmn:incoming>
      <bpmn:outgoing>FT1_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BE_P1_ClaimErr" name="Lỗi / Từ chối bảo hiểm" attachedToRef="ST_P1_SubmitClaim">
      <bpmn:outgoing>FT1_20</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_BE_P1_ClaimErr" errorRef="Error_InsuranceClaimRejected" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UT_P1_HandleClaimEx" name="Giám định viên xử lý ngoại lệ bảo hiểm" camunda:candidateGroups="insurance_auditors" camunda:formKey="camunda-forms:app:forms/claim-exception.form">
      <bpmn:incoming>FT1_20</bpmn:incoming>
      <bpmn:outgoing>FT1_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_P1_RetryOrSelfPay" name="Gửi lại cổng BH?">
      <bpmn:incoming>FT1_21</bpmn:incoming>
      <bpmn:outgoing>FT1_22</bpmn:outgoing>
      <bpmn:outgoing>FT1_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST_P1_FinalSettlement" name="Tổng hợp bảng kê &amp; tất toán ra viện" camunda:type="external" camunda:topic="billing-final-settlement">
      <bpmn:incoming>FT1_19</bpmn:incoming>
      <bpmn:incoming>FT1_23</bpmn:incoming>
      <bpmn:outgoing>FT1_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_P1_ToBe" name="Hoàn tất xuất viện">
      <bpmn:incoming>FT1_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FT1_1" sourceRef="Start_P1_Kiosk" targetRef="ST_P1_SyncHIS" />
    <bpmn:sequenceFlow id="FT1_2" sourceRef="ST_P1_SyncHIS" targetRef="UT_P1_VitalSigns" />
    <bpmn:sequenceFlow id="FT1_3" sourceRef="UT_P1_VitalSigns" targetRef="BRT_P1_TriageDMN" />
    <bpmn:sequenceFlow id="FT1_4" sourceRef="BRT_P1_TriageDMN" targetRef="GW_P1_PrioritySplit" />
    <bpmn:sequenceFlow id="FT1_5" name="EMERGENCY" sourceRef="GW_P1_PrioritySplit" targetRef="ST_P1_EmergencyAlert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${triageResult.priorityLevel == 'EMERGENCY'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FT1_6" name="PRIORITY / STANDARD" sourceRef="GW_P1_PrioritySplit" targetRef="ST_P1_QueueAssign">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${triageResult.priorityLevel != 'EMERGENCY'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FT1_7" sourceRef="ST_P1_EmergencyAlert" targetRef="GW_P1_PriorityJoin" />
    <bpmn:sequenceFlow id="FT1_8" sourceRef="ST_P1_QueueAssign" targetRef="GW_P1_PriorityJoin" />
    <bpmn:sequenceFlow id="FT1_9" sourceRef="GW_P1_PriorityJoin" targetRef="UT_P1_DoctorOrder" />
    <bpmn:sequenceFlow id="FT1_10" sourceRef="UT_P1_DoctorOrder" targetRef="GW_P1_OrderFork" />
    <bpmn:sequenceFlow id="FT1_11" sourceRef="GW_P1_OrderFork" targetRef="ST_P1_CallLIS" />
    <bpmn:sequenceFlow id="FT1_12" sourceRef="GW_P1_OrderFork" targetRef="ST_P1_BookRIS" />
    <bpmn:sequenceFlow id="FT1_13" sourceRef="GW_P1_OrderFork" targetRef="ST_P1_CalcDeposit" />
    <bpmn:sequenceFlow id="FT1_14" sourceRef="ST_P1_CallLIS" targetRef="GW_P1_OrderJoin" />
    <bpmn:sequenceFlow id="FT1_15" sourceRef="ST_P1_BookRIS" targetRef="GW_P1_OrderJoin" />
    <bpmn:sequenceFlow id="FT1_16" sourceRef="ST_P1_CalcDeposit" targetRef="GW_P1_OrderJoin" />
    <bpmn:sequenceFlow id="FT1_17" sourceRef="GW_P1_OrderJoin" targetRef="UT_P1_DoctorDischarge" />
    <bpmn:sequenceFlow id="FT1_18" sourceRef="UT_P1_DoctorDischarge" targetRef="ST_P1_SubmitClaim" />
    <bpmn:sequenceFlow id="FT1_19" name="Hợp lệ" sourceRef="ST_P1_SubmitClaim" targetRef="ST_P1_FinalSettlement" />
    <bpmn:sequenceFlow id="FT1_20" sourceRef="BE_P1_ClaimErr" targetRef="UT_P1_HandleClaimEx" />
    <bpmn:sequenceFlow id="FT1_21" sourceRef="UT_P1_HandleClaimEx" targetRef="GW_P1_RetryOrSelfPay" />
    <bpmn:sequenceFlow id="FT1_22" name="Gửi lại" sourceRef="GW_P1_RetryOrSelfPay" targetRef="ST_P1_SubmitClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resubmitClaim == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FT1_23" name="Chuyển tự chi trả" sourceRef="GW_P1_RetryOrSelfPay" targetRef="ST_P1_FinalSettlement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resubmitClaim == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FT1_24" sourceRef="ST_P1_FinalSettlement" targetRef="End_P1_ToBe" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Hospital_ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Hospital_ToBe" bpmnElement="Collaboration_Process_Hospital_ToBe">
      <bpmndi:BPMNShape id="Participant_External_Process_Hospital_ToBe_di" bpmnElement="Participant_External_Process_Hospital_ToBe" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="2966" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Process_Hospital_ToBe_di" bpmnElement="Participant_Process_Hospital_ToBe" isHorizontal="true">
        <dc:Bounds x="160" y="170" width="2966" height="990" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P1_System_di" bpmnElement="Lane_P1_System" isHorizontal="true">
        <dc:Bounds x="190" y="170" width="2936" height="460" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P1_TriageNurse_di" bpmnElement="Lane_P1_TriageNurse" isHorizontal="true">
        <dc:Bounds x="190" y="630" width="2936" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P1_ClinicalDoctor_di" bpmnElement="Lane_P1_ClinicalDoctor" isHorizontal="true">
        <dc:Bounds x="190" y="800" width="2936" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P1_Auditor_di" bpmnElement="Lane_P1_Auditor" isHorizontal="true">
        <dc:Bounds x="190" y="970" width="2936" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_P1_Kiosk_di" bpmnElement="Start_P1_Kiosk">
        <dc:Bounds x="232" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P1_SyncHIS_di" bpmnElement="ST_P1_SyncHIS">
        <dc:Bounds x="370" y="360" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_P1_VitalSigns_di" bpmnElement="UT_P1_VitalSigns">
        <dc:Bounds x="545" y="685" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BRT_P1_TriageDMN_di" bpmnElement="BRT_P1_TriageDMN">
        <dc:Bounds x="720" y="360" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P1_PrioritySplit_di" bpmnElement="GW_P1_PrioritySplit">
        <dc:Bounds x="925" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P1_EmergencyAlert_di" bpmnElement="ST_P1_EmergencyAlert">
        <dc:Bounds x="1070" y="225" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P1_QueueAssign_di" bpmnElement="ST_P1_QueueAssign">
        <dc:Bounds x="1070" y="495" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P1_PriorityJoin_di" bpmnElement="GW_P1_PriorityJoin">
        <dc:Bounds x="1275" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_P1_DoctorOrder_di" bpmnElement="UT_P1_DoctorOrder">
        <dc:Bounds x="1420" y="855" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P1_OrderFork_di" bpmnElement="GW_P1_OrderFork">
        <dc:Bounds x="1625" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P1_CallLIS_di" bpmnElement="ST_P1_CallLIS">
        <dc:Bounds x="1770" y="225" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P1_BookRIS_di" bpmnElement="ST_P1_BookRIS">
        <dc:Bounds x="1770" y="360" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P1_CalcDeposit_di" bpmnElement="ST_P1_CalcDeposit">
        <dc:Bounds x="1770" y="495" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P1_OrderJoin_di" bpmnElement="GW_P1_OrderJoin">
        <dc:Bounds x="1975" y="375" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_P1_DoctorDischarge_di" bpmnElement="UT_P1_DoctorDischarge">
        <dc:Bounds x="2120" y="855" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P1_SubmitClaim_di" bpmnElement="ST_P1_SubmitClaim">
        <dc:Bounds x="2295" y="360" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BE_P1_ClaimErr_di" bpmnElement="BE_P1_ClaimErr">
        <dc:Bounds x="2332" y="422" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_P1_HandleClaimEx_di" bpmnElement="UT_P1_HandleClaimEx">
        <dc:Bounds x="2418" y="1025" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P1_RetryOrSelfPay_di" bpmnElement="GW_P1_RetryOrSelfPay">
        <dc:Bounds x="2622" y="1040" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P1_FinalSettlement_di" bpmnElement="ST_P1_FinalSettlement">
        <dc:Bounds x="2768" y="360" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_P1_ToBe_di" bpmnElement="End_P1_ToBe">
        <dc:Bounds x="2980" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FT1_1_di" bpmnElement="FT1_1">
        <di:waypoint x="268" y="400" />
        <di:waypoint x="370" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT1_2_di" bpmnElement="FT1_2">
        <di:waypoint x="480" y="400" />
        <di:waypoint x="512" y="400" />
        <di:waypoint x="512" y="725" />
        <di:waypoint x="545" y="725" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT1_3_di" bpmnElement="FT1_3">
        <di:waypoint x="655" y="725" />
        <di:waypoint x="688" y="725" />
        <di:waypoint x="688" y="400" />
        <di:waypoint x="720" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT1_4_di" bpmnElement="FT1_4">
        <di:waypoint x="830" y="400" />
        <di:waypoint x="925" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT1_5_di" bpmnElement="FT1_5">
        <di:waypoint x="975" y="400" />
        <di:waypoint x="1022" y="400" />
        <di:waypoint x="1022" y="265" />
        <di:waypoint x="1070" y="265" />
