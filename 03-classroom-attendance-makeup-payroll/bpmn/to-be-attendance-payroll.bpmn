<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process_Attendance_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:message id="Message_TeacherLeave" name="TeacherLeaveRequested" />
  <bpmn:message id="Message_AttendanceDone" name="AttendanceCompleted" />
  <bpmn:message id="Message_MakeupSlotPicked" name="MakeupSlotSelected" />
  <bpmn:collaboration id="Collaboration_Process_Attendance_ToBe">
    <bpmn:participant id="Participant_External_Process_Attendance_ToBe" name="App Giáo viên / Phụ huynh &amp; Hệ thống Lịch / Lương" />
    <bpmn:participant id="Participant_Process_Attendance_ToBe" name="Hệ thống Điều phối Lớp học &amp; Thù lao (To-Be)" processRef="Process_Attendance_ToBe" />
    <bpmn:messageFlow id="MF3_1" name="Đơn báo nghỉ GV" sourceRef="Participant_External_Process_Attendance_ToBe" targetRef="Catch_P3_Leave" />
    <bpmn:messageFlow id="MF3_2" name="Dữ liệu điểm danh" sourceRef="Participant_External_Process_Attendance_ToBe" targetRef="Catch_P3_Attend" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Attendance_ToBe" name="Lớp học: Điểm danh, Học bù &amp; Đối soát Thù lao (To-Be)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Process_Attendance_ToBe">
      <bpmn:lane id="Lane_P3_System" name="Hệ thống Điều phối (Camunda + DMN + Messaging)">
        <bpmn:flowNodeRef>Start_P3_Session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P3_WaitEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_P3_Leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_P3_FindSub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_P3_Attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P3_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P3_HasAbsent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_P3_Makeup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_P3_CalcRate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P3_RecordLedger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P3_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_P3_LockDisburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_P3_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_AcademicOps" name="Bộ phận Giáo vụ">
        <bpmn:flowNodeRef>UT_P3_ConfirmSub</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_TeacherRole" name="Giáo viên">
        <bpmn:flowNodeRef>UT_P3_ReviewPayroll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_P3_Disputed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_P3_Timer48H</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3_PayrollAdmin" name="Kế toán Lương">
        <bpmn:flowNodeRef>UT_P3_ResolveDispute</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_P3_Session" name="Khởi tạo phiên buổi học">
      <bpmn:outgoing>FT3_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:eventBasedGateway id="GW_P3_WaitEvent" name="Chờ sự kiện buổi học">
      <bpmn:incoming>FT3_1</bpmn:incoming>
      <bpmn:outgoing>FT3_2</bpmn:outgoing>
      <bpmn:outgoing>FT3_3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_P3_Leave" name="GV gửi đơn báo nghỉ">
      <bpmn:incoming>FT3_2</bpmn:incoming>
      <bpmn:outgoing>FT3_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Catch_P3_Leave" messageRef="Message_TeacherLeave" />
    </bpmn:intermediateCatchEvent>
    <bpmn:businessRuleTask id="BRT_P3_FindSub" name="DMN Lọc giáo viên dạy thay phù hợp" camunda:resultVariable="subCandidates" camunda:decisionRef="Decision_SubstituteEligibility" camunda:mapDecisionResult="resultList">
      <bpmn:incoming>FT3_4</bpmn:incoming>
      <bpmn:outgoing>FT3_5</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="UT_P3_ConfirmSub" name="Giáo vụ xác nhận GV dạy thay" camunda:candidateGroups="academic_ops" camunda:formKey="camunda-forms:app:forms/assign-substitute.form">
      <bpmn:incoming>FT3_5</bpmn:incoming>
      <bpmn:outgoing>FT3_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_P3_Attend" name="Hoàn tất điểm danh buổi học">
      <bpmn:incoming>FT3_3</bpmn:incoming>
      <bpmn:incoming>FT3_6</bpmn:incoming>
      <bpmn:outgoing>FT3_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Catch_P3_Attend" messageRef="Message_AttendanceDone" />
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="GW_P3_Fork" name="Tách luồng xử lý">
      <bpmn:incoming>FT3_7</bpmn:incoming>
      <bpmn:outgoing>FT3_8</bpmn:outgoing>
      <bpmn:outgoing>FT3_16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_P3_HasAbsent" name="Có HV vắng có phép?">
      <bpmn:incoming>FT3_8</bpmn:incoming>
      <bpmn:outgoing>FT3_9</bpmn:outgoing>
      <bpmn:outgoing>FT3_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_P3_Makeup" name="Multi-Instance: Theo dõi học bù từng HV">
      <bpmn:incoming>FT3_9</bpmn:incoming>
      <bpmn:outgoing>FT3_15</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="${absentStudents}" camunda:elementVariable="student"></bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="SubStart_P3">
        <bpmn:outgoing>FT3_11</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ST_P3_SendSlots" name="Gửi phụ huynh các slot học bù" camunda:type="external" camunda:topic="send-parent-makeup-slots">
        <bpmn:incoming>FT3_11</bpmn:incoming>
        <bpmn:outgoing>FT3_12</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="Catch_P3_SlotPicked" name="Phụ huynh chọn lịch bù">
        <bpmn:incoming>FT3_12</bpmn:incoming>
        <bpmn:outgoing>FT3_13</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MsgDef_Catch_P3_SlotPicked" messageRef="Message_MakeupSlotPicked" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="ST_P3_CompleteMakeup" name="Ghi nhận &amp; theo dõi hoàn thành bù" camunda:type="external" camunda:topic="track-makeup-completion">
        <bpmn:incoming>FT3_13</bpmn:incoming>
        <bpmn:outgoing>FT3_14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="SubEnd_P3">
        <bpmn:incoming>FT3_14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FT3_11" sourceRef="SubStart_P3" targetRef="ST_P3_SendSlots" />
      <bpmn:sequenceFlow id="FT3_12" sourceRef="ST_P3_SendSlots" targetRef="Catch_P3_SlotPicked" />
      <bpmn:sequenceFlow id="FT3_13" sourceRef="Catch_P3_SlotPicked" targetRef="ST_P3_CompleteMakeup" />
      <bpmn:sequenceFlow id="FT3_14" sourceRef="ST_P3_CompleteMakeup" targetRef="SubEnd_P3" />
    </bpmn:subProcess>
    <bpmn:businessRuleTask id="BRT_P3_CalcRate" name="DMN Tính đơn giá thù lao buổi dạy" camunda:resultVariable="rateResult" camunda:decisionRef="Decision_TeachingRate" camunda:mapDecisionResult="singleResult">
      <bpmn:incoming>FT3_16</bpmn:incoming>
      <bpmn:outgoing>FT3_17</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="ST_P3_RecordLedger" name="Ghi nhận công buổi dạy vào sổ lương" camunda:type="external" camunda:topic="record-session-payroll">
      <bpmn:incoming>FT3_17</bpmn:incoming>
      <bpmn:outgoing>FT3_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="GW_P3_Join" name="Hội tụ">
      <bpmn:incoming>FT3_10</bpmn:incoming>
      <bpmn:incoming>FT3_15</bpmn:incoming>
      <bpmn:incoming>FT3_18</bpmn:incoming>
      <bpmn:outgoing>FT3_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UT_P3_ReviewPayroll" name="Cuối tháng: GV kiểm tra phiếu lương" camunda:assignee="${teacherId}" camunda:formKey="camunda-forms:app:forms/payroll-review.form">
      <bpmn:incoming>FT3_19</bpmn:incoming>
      <bpmn:outgoing>FT3_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BE_P3_Timer48H" name="Sau 48h không khiếu nại" cancelActivity="true" attachedToRef="UT_P3_ReviewPayroll">
      <bpmn:outgoing>FT3_21</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_BE_P3_Timer48H">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="GW_P3_Disputed" name="Có khiếu nại?">
      <bpmn:incoming>FT3_20</bpmn:incoming>
      <bpmn:outgoing>FT3_22</bpmn:outgoing>
      <bpmn:outgoing>FT3_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_P3_ResolveDispute" name="Kế toán đối soát &amp; điều chỉnh sai lệch" camunda:candidateGroups="payroll_admins" camunda:formKey="camunda-forms:app:forms/payroll-dispute.form">
      <bpmn:incoming>FT3_23</bpmn:incoming>
      <bpmn:outgoing>FT3_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_P3_LockDisburse" name="Khóa sổ lương &amp; chuyển chờ giải ngân" camunda:type="external" camunda:topic="payroll-lock-and-disburse">
      <bpmn:incoming>FT3_21</bpmn:incoming>
      <bpmn:incoming>FT3_22</bpmn:incoming>
      <bpmn:incoming>FT3_24</bpmn:incoming>
      <bpmn:outgoing>FT3_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_P3_ToBe" name="Hoàn tất đối soát &amp; chi trả">
      <bpmn:incoming>FT3_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FT3_1" sourceRef="Start_P3_Session" targetRef="GW_P3_WaitEvent" />
    <bpmn:sequenceFlow id="FT3_2" sourceRef="GW_P3_WaitEvent" targetRef="Catch_P3_Leave" />
    <bpmn:sequenceFlow id="FT3_3" sourceRef="GW_P3_WaitEvent" targetRef="Catch_P3_Attend" />
    <bpmn:sequenceFlow id="FT3_4" sourceRef="Catch_P3_Leave" targetRef="BRT_P3_FindSub" />
    <bpmn:sequenceFlow id="FT3_5" sourceRef="BRT_P3_FindSub" targetRef="UT_P3_ConfirmSub" />
    <bpmn:sequenceFlow id="FT3_6" sourceRef="UT_P3_ConfirmSub" targetRef="Catch_P3_Attend" />
    <bpmn:sequenceFlow id="FT3_7" sourceRef="Catch_P3_Attend" targetRef="GW_P3_Fork" />
    <bpmn:sequenceFlow id="FT3_8" sourceRef="GW_P3_Fork" targetRef="GW_P3_HasAbsent" />
    <bpmn:sequenceFlow id="FT3_9" name="Có HV vắng" sourceRef="GW_P3_HasAbsent" targetRef="Sub_P3_Makeup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${absentStudents.size() &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FT3_10" name="Đi học đủ" sourceRef="GW_P3_HasAbsent" targetRef="GW_P3_Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${absentStudents.size() == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FT3_15" sourceRef="Sub_P3_Makeup" targetRef="GW_P3_Join" />
    <bpmn:sequenceFlow id="FT3_16" sourceRef="GW_P3_Fork" targetRef="BRT_P3_CalcRate" />
    <bpmn:sequenceFlow id="FT3_17" sourceRef="BRT_P3_CalcRate" targetRef="ST_P3_RecordLedger" />
    <bpmn:sequenceFlow id="FT3_18" sourceRef="ST_P3_RecordLedger" targetRef="GW_P3_Join" />
    <bpmn:sequenceFlow id="FT3_19" sourceRef="GW_P3_Join" targetRef="UT_P3_ReviewPayroll" />
    <bpmn:sequenceFlow id="FT3_20" sourceRef="UT_P3_ReviewPayroll" targetRef="GW_P3_Disputed" />
    <bpmn:sequenceFlow id="FT3_21" name="Tự động khóa sổ (48h)" sourceRef="BE_P3_Timer48H" targetRef="ST_P3_LockDisburse" />
    <bpmn:sequenceFlow id="FT3_22" name="Xác nhận đúng" sourceRef="GW_P3_Disputed" targetRef="ST_P3_LockDisburse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${disputed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FT3_23" name="Khiếu nại sai lệch" sourceRef="GW_P3_Disputed" targetRef="UT_P3_ResolveDispute">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${disputed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FT3_24" sourceRef="UT_P3_ResolveDispute" targetRef="ST_P3_LockDisburse" />
    <bpmn:sequenceFlow id="FT3_25" sourceRef="ST_P3_LockDisburse" targetRef="End_P3_ToBe" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_Attendance_ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_Attendance_ToBe" bpmnElement="Collaboration_Process_Attendance_ToBe">
      <bpmndi:BPMNShape id="Participant_External_Process_Attendance_ToBe_di" bpmnElement="Participant_External_Process_Attendance_ToBe" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="3053" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Process_Attendance_ToBe_di" bpmnElement="Participant_Process_Attendance_ToBe" isHorizontal="true">
        <dc:Bounds x="160" y="170" width="3053" height="885" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P3_System_di" bpmnElement="Lane_P3_System" isHorizontal="true">
        <dc:Bounds x="190" y="170" width="3023" height="345" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P3_AcademicOps_di" bpmnElement="Lane_P3_AcademicOps" isHorizontal="true">
        <dc:Bounds x="190" y="515" width="3023" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P3_TeacherRole_di" bpmnElement="Lane_P3_TeacherRole" isHorizontal="true">
        <dc:Bounds x="190" y="685" width="3023" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P3_PayrollAdmin_di" bpmnElement="Lane_P3_PayrollAdmin" isHorizontal="true">
        <dc:Bounds x="190" y="885" width="3023" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_P3_Session_di" bpmnElement="Start_P3_Session">
        <dc:Bounds x="232" y="314" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P3_WaitEvent_di" bpmnElement="GW_P3_WaitEvent">
        <dc:Bounds x="400" y="308" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_P3_Leave_di" bpmnElement="Catch_P3_Leave">
        <dc:Bounds x="582" y="247" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BRT_P3_FindSub_di" bpmnElement="BRT_P3_FindSub">
        <dc:Bounds x="720" y="225" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_P3_ConfirmSub_di" bpmnElement="UT_P3_ConfirmSub">
        <dc:Bounds x="895" y="570" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_P3_Attend_di" bpmnElement="Catch_P3_Attend">
        <dc:Bounds x="1107" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P3_Fork_di" bpmnElement="GW_P3_Fork">
        <dc:Bounds x="1275" y="308" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P3_HasAbsent_di" bpmnElement="GW_P3_HasAbsent">
        <dc:Bounds x="1450" y="240" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_P3_Makeup_di" bpmnElement="Sub_P3_Makeup" isExpanded="true">
        <dc:Bounds x="1608" y="190" width="645" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubStart_P3_di" bpmnElement="SubStart_P3">
        <dc:Bounds x="1640" y="247" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P3_SendSlots_di" bpmnElement="ST_P3_SendSlots">
        <dc:Bounds x="1748" y="225" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_P3_SlotPicked_di" bpmnElement="Catch_P3_SlotPicked">
        <dc:Bounds x="1930" y="247" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P3_CompleteMakeup_di" bpmnElement="ST_P3_CompleteMakeup">
        <dc:Bounds x="2038" y="225" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubEnd_P3_di" bpmnElement="SubEnd_P3">
        <dc:Bounds x="2191" y="247" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BRT_P3_CalcRate_di" bpmnElement="BRT_P3_CalcRate">
        <dc:Bounds x="1560" y="400" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P3_RecordLedger_di" bpmnElement="ST_P3_RecordLedger">
        <dc:Bounds x="1823" y="400" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P3_Join_di" bpmnElement="GW_P3_Join">
        <dc:Bounds x="2325" y="308" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_P3_ReviewPayroll_di" bpmnElement="UT_P3_ReviewPayroll">
        <dc:Bounds x="2470" y="740" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BE_P3_Timer48H_di" bpmnElement="BE_P3_Timer48H">
        <dc:Bounds x="2507" y="802" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_P3_Disputed_di" bpmnElement="GW_P3_Disputed">
        <dc:Bounds x="2692" y="755" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_P3_ResolveDispute_di" bpmnElement="UT_P3_ResolveDispute">
        <dc:Bounds x="2662" y="940" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_P3_LockDisburse_di" bpmnElement="ST_P3_LockDisburse">
        <dc:Bounds x="2855" y="292" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_P3_ToBe_di" bpmnElement="End_P3_ToBe">
        <dc:Bounds x="3067" y="314" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FT3_1_di" bpmnElement="FT3_1">
        <di:waypoint x="268" y="332" />
        <di:waypoint x="400" y="332" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT3_2_di" bpmnElement="FT3_2">
        <di:waypoint x="450" y="333" />
        <di:waypoint x="516" y="333" />
        <di:waypoint x="516" y="265" />
        <di:waypoint x="582" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FT3_3_di" bpmnElement="FT3_3">
